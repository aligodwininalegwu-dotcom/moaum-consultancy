# SQLite for local development (file lives in prisma/dev.db)
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/moaum_consultancy"

NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me"

# Where uploaded application documents are stored (kept outside /public)
UPLOAD_DIR="./uploads"

# ── Email (optional) ────────────────────────────────────────────────
# Without SMTP_HOST, emails are printed to the server log instead of sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=<16-character app password from myaccount.google.com/apppasswords>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="\"MOAUM Consultancy\" <no-reply@moaum.edu.ng>"
# Where contact-form enquiries are delivered
MAIL_UNIT_INBOX="consultancy@moaum.edu.ng"

# ── Paystack online payments (optional) ─────────────────────────────
# Without a key, programmes use bank transfer + manual verification only.
# Start with test keys (sk_test_…) from dashboard.paystack.com → Settings → API Keys.
# Webhook URL to set in Paystack: https://<your-domain>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=""
